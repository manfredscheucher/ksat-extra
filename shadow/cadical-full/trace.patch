--- a/lstrace.hpp
+++ b/lstrace.hpp
@@ -0,0 +1,49 @@
+#ifndef _lstrace_hpp_INCLUDED
+#define _lstrace_hpp_INCLUDED
+
+// Trace instrumentation for the ksat shadow reference (NOT upstream).
+// Added by ksat-extra/shadow/cadical-full/trace.patch. Output only: every
+// line goes to stdout and only when the environment variable LSTRACE is set.
+// Nothing here reads or writes solver state except through read-only
+// accessors ('externalize', clause literals, 'id').
+
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+
+namespace CaDiCaL {
+
+inline bool lstrace_on () {
+  static const bool on = getenv ("LSTRACE") != 0;
+  return on;
+}
+
+#define LSTRACE(...) \
+  do { \
+    if (::CaDiCaL::lstrace_on ()) \
+      printf (__VA_ARGS__); \
+  } while (0)
+
+// Print ' <l1> <l2> ... <lk> 0' (external literals, stored order).
+// Templates so this header can be included before 'Internal' is complete.
+template <class I, class C>
+inline void lstrace_lits (I *internal, const C &lits) {
+  for (const auto &lit : lits)
+    printf (" %d", internal->externalize (lit));
+  printf (" 0");
+}
+
+// 'START <name>' when the enclosing upstream function is entered and
+// 'END <name>' when it is left (by any return path).
+struct LSTracePhase {
+  const char *name;
+  LSTracePhase (const char *n) : name (n) { LSTRACE ("START %s\n", name); }
+  ~LSTracePhase () { LSTRACE ("END %s\n", name); }
+};
+
+#define LSTRACE_PHASE(NAME) \
+  ::CaDiCaL::LSTracePhase lstrace_phase_guard (NAME)
+
+} // namespace CaDiCaL
+
+#endif
