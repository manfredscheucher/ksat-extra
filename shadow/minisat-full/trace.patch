@@ -0,0 +1,52 @@
+/*****************************************************************************[lstrace.h]
+Shadow-trace support for the instrumented MiniSat reference (ksat-extra/shadow/minisat-full).
+NOT part of upstream MiniSat. Prints one event per line to stdout, only when the environment
+variable LSTRACE is set. Added by trace.patch; see ../README.md for the event vocabulary.
+**************************************************************************************************/
+
+#ifndef Minisat_lstrace_h
+#define Minisat_lstrace_h
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "minisat/core/SolverTypes.h"
+
+namespace Minisat {
+
+static inline bool lstrace_on() {
+    static const bool on = getenv("LSTRACE") != NULL;
+    return on;
+}
+
+#define LSTRACE(...) do { if (Minisat::lstrace_on()) printf(__VA_ARGS__); } while (0)
+
+// Signed DIMACS literal of an internal literal (var v -> v+1).
+static inline int lstrace_dimacs(Lit p) { return sign(p) ? -(var(p) + 1) : var(p) + 1; }
+
+// Prints " l1 l2 ... lk 0\n" (literals in current stored order). Caller checks lstrace_on().
+template<class C>
+static inline void lstrace_lits(const C& c) {
+    for (int i = 0; i < c.size(); i++) printf(" %d", lstrace_dimacs(c[i]));
+    printf(" 0\n");
+}
+
+// "<head> : l1 ... lk 0"
+template<class C>
+static inline void lstrace_clause(const char* head, const C& c) {
+    if (!lstrace_on()) return;
+    printf("%s :", head);
+    lstrace_lits(c);
+}
+
+// "START <name>" now, "END <name>" when the enclosing scope is left (any return).
+struct LstracePhase {
+    const char* name;
+    explicit LstracePhase(const char* n) : name(n) { LSTRACE("START %s\n", name); }
+    ~LstracePhase() { LSTRACE("END %s\n", name); }
+};
+#define LSTRACE_PHASE(n) Minisat::LstracePhase lstrace_phase_guard(n)
+
+}
+
+#endif
