# Shadow: regenerable artifacts (golden traces + compiled C binaries).
# The CNFs and *.c/*.cc sources and scripts ARE committed; the golden traces are
# regenerated by shadow/tools/regen_golden*.sh, and the C binaries by cc/c++.
shadow/golden*/
shadow/**/*_trace
shadow/**/*_orig
shadow/**/*_bench
shadow/minisat-c/include/

__pycache__/
